# Run npm run setup -- --cloud to create a private .env.cloud and random secret.
# Never prefix secrets with VITE_ or commit this file after adding real values.
HUB_APP_ORIGIN=https://hub.example.com
HUB_OWNER_EMAIL=owner@example.com
DATABASE_URL=
NEON_AUTH_BASE_URL=
HUB_SESSION_SECRET=GENERATE_WITH_SETUP
# Optional: the Vercel team ID for your deployments (team_...), not a team name.
HUB_TEAM_ID=
# Optional: connect these in the authenticated hub instead.
HUB_GITHUB_TOKEN=
HUB_VERCEL_TOKEN=
