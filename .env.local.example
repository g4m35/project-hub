# Local app: no account or API token required to start. Never commit .env.local.
PORT=3007
# Optional: absolute folder for hub.json. Default is this checkout's .data/.
# HUB_DATA_DIR=/your/private/data/folder
# Optional: allowed project folders, separated by : (macOS/Linux).
# Defaults: this checkout, ~/Desktop, ~/Documents, ~/dev, ~/Developer.
# HUB_PROJECT_ROOTS=/your/projects:/your/other/projects

# Optional read-only provider credentials. GitHub CLI login is also supported.
HUB_GITHUB_TOKEN=
HUB_VERCEL_TOKEN=

# Local Codex/T3 metadata access is OFF until you opt in.
HUB_ENABLE_CHATS=0
# Include recent chats unrelated to linked projects only if you want them.
HUB_INCLUDE_UNASSIGNED_CHATS=0
